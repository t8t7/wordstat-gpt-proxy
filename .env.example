# Copy to .env on the server and replace every placeholder.
YANDEX_API_KEY=replace-with-yandex-api-key
YANDEX_FOLDER_ID=replace-with-yandex-folder-id
PROXY_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Non-secret operational settings.
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
YANDEX_TIMEOUT_SECONDS=15
WORDSTAT_NUM_PHRASES=50
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://wordstat.example.com
