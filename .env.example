# Copy to .env on the server and replace the proxy secret.
PROXY_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Non-secret operational settings.
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WORDSTAT_TIMEOUT_SECONDS=30
WORDSTAT_NUM_PHRASES=50
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://wordstat.example.com
